#!/bin/sh

set -e

echo "=== FreeBSD Root Setup ==="

if [ "$(id -u)" -ne 0 ]; then
    echo "Run this script as root."
    exit 1
fi

printf "Enter target username: "
read TARGET_USER

if ! id "$TARGET_USER" >/dev/null 2>&1; then
    echo "User '$TARGET_USER' does not exist."
    exit 1
fi

# echo
# echo "Updating package repository..."
# pkg update

echo
echo "Upgrading installed packages..."
pkg upgrade -y

echo
echo "Installing packages..."

pkg install -y \
sudo fzf htop rsync flock ImageMagick7 dejavu noto-basic noto-emoji \
i3 i3lock i3status dmenu rofi polybar dunst feh arandr xterm xss-lock \
bash git curl wget neovim micro ncdu nnn figlet \
xf86-video-vesa xorg alacritty lxappearance gtk3 dhcpcd lightdm lightdm-gtk-greeter \
firefox python3 xclip autocutsel starship unzip vscode \
calcurse doas qpwgraph maim redshift \
pipewire wireplumber pipewire-module-xrdp-0.1 \
inotify-tools zsh \
papirus-icon-theme materia-gtk-theme \
ollama python kdenlive krita gimp ardour okular libreoffice wine cabextract \
cups gutenprint hplip

# py311-i3ipc pipewire-spa-oss-g20251117_3

if [ -x /usr/local/share/wine/pkg32.sh ]; then
    /usr/local/share/wine/pkg32.sh --old install -r FreeBSD-ports wine mesa-dri
fi




echo
echo "Adding user to groups..."

pw groupmod wheel -m "$TARGET_USER"
pw groupmod video -m "$TARGET_USER"

echo
echo "Configuring doas..."

DOAS_FILE="/usr/local/etc/doas.conf"

install -m 0400 /dev/null "$DOAS_FILE"

grep -qxF 'permit nopass :wheel cmd shutdown' "$DOAS_FILE" || \
echo 'permit nopass :wheel cmd shutdown' >> "$DOAS_FILE"

grep -qxF 'permit nopass :wheel cmd reboot' "$DOAS_FILE" || \
echo 'permit nopass :wheel cmd reboot' >> "$DOAS_FILE"

echo
echo "Configuring sudo wheel group..."

cp /usr/local/etc/sudoers /usr/local/etc/sudoers.bak

sed -i '' \
's/^# %wheel ALL=(ALL:ALL) ALL/%wheel ALL=(ALL:ALL) ALL/' \
/usr/local/etc/sudoers

echo
echo "Configuring loader.conf..."

sysrc -f /boot/loader.conf kern.vty=vt

echo
echo "Enabling services..."

# ee /etc/rc.conf

#sysrc wireplumber_enable="YES"
#sysrc pipewire_enable="YES"
sysrc dhcpcd_enable="YES"
sysrc dbus_enable="YES"
sysrc ollama_enable=YES
sysrc cupsd_enable="YES"
sysrc devd_enable="YES"
sysrc lightdm_enable="YES"

echo
echo "Starting dhcpcd..."

service dhcpcd start || true

echo
echo "Starting ollama..."

service ollama start || true
service dbus start

echo
echo "Root setup complete."
echo "Now login as $TARGET_USER and run user-setup.sh"
